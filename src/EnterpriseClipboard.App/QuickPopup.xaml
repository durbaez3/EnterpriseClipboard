<Window x:Class="EnterpriseClipboard.App.QuickPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnterpriseClipboard.App"
        mc:Ignorable="d"
        Title="Historial Rápido" 
        Height="675" Width="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Border Background="#11131C" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1.5" 
            CornerRadius="12" 
            Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox" 
                     Grid.Row="0" 
                     Style="{StaticResource ModernTextBox}" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10" 
                     Margin="0,0,0,15"
                     GotFocus="SearchBox_GotFocus"/>

            <!-- Paged clips List -->
            <ListBox x:Name="ClipsList" 
                     Grid.Row="1" 
                     ItemsSource="{Binding Items}" 
                     SelectedItem="{Binding SelectedItem}"
                     Style="{StaticResource ModernListBox}"
                     MouseDoubleClick="ClipsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Application and Type -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SourceApplication}" 
                                           Foreground="{StaticResource PrimaryAccentBrush}" 
                                           FontSize="10" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding ContentType}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="10" 
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Clip preview text or Image -->
                            <ContentControl Grid.Row="1" Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PreviewText}" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                                               FontSize="12" 
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContentType}" Value="Image">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" ClipToBounds="True" HorizontalAlignment="Left">
                                                                <Image Source="{Binding ThumbnailPath}" MaxHeight="45" Stretch="Uniform"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
