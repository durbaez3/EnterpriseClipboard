<Window x:Class="EnterpriseClipboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnterpriseClipboard.App"
        xmlns:viewmodels="clr-namespace:EnterpriseClipboard.App.ViewModels"
        mc:Ignorable="d"
        Title="Enterprise Clipboard Manager" 
        Height="650" Width="1700"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel with Title, Status and Action Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Enterprise Clipboard Manager" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,20,0"/>
                
                <TextBox Width="300" 
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8,12,8"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Control Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pause / Resume Capture -->
                <Button Content="{Binding IsPaused, Converter={local:PauseStatusConverter}}" 
                        Command="{Binding TogglePauseCommand}"
                        Style="{StaticResource ModernButton}"
                        Margin="0,0,10,0"
                        Background="#1F2937"/>
                
                <!-- Clear history -->
                <Button Content="Limpiar Historial" 
                        Command="{Binding ClearHistoryCommand}"
                        Style="{StaticResource ModernButton}"
                        Margin="0,0,10,0"
                        Background="{StaticResource DangerBrush}"/>

                <!-- Configuration button -->
                <Button Content="Configuración" 
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="#2563EB"/>
            </StackPanel>
        </Grid>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Virtualized Clips List -->
            <ListBox Grid.Column="0" 
                     ItemsSource="{Binding Items}" 
                     SelectedItem="{Binding SelectedItem}"
                     Style="{StaticResource ModernListBox}"
                     MouseDoubleClick="ClipsList_MouseDoubleClick"
                     Margin="0,0,15,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top row: source app and time -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SourceApplication}" 
                                               Foreground="{StaticResource PrimaryAccentBrush}" 
                                               FontWeight="SemiBold" 
                                               FontSize="11"/>
                                    <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ContentType}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="11" 
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding CreatedAt, StringFormat=\{0:HH:mm:ss - dd/MM\}}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="11"/>
                            </Grid>

                            <!-- Mid row: content preview (text or thumbnail) -->
                            <ContentControl Grid.Row="1" Content="{Binding}" Margin="0,4,0,6">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!-- Default is Text Preview -->
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PreviewText}" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                                               FontSize="13" 
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- If Image, show thumbnail -->
                                            <DataTrigger Binding="{Binding ContentType}" Value="Image">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" ClipToBounds="True">
                                                                    <Image Source="{Binding ThumbnailPath}" MaxHeight="60" Stretch="Uniform"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <!-- Bottom row: quick actions -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <!-- Favorito button -->
                                <Button Content="★" 
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" 
                                        Foreground="{Binding IsFavorite, Converter={local:FavoriteColorConverter}}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        FontSize="14"
                                        Margin="0,0,12,0" 
                                        Cursor="Hand"/>
                                
                                <!-- Fijar button -->
                                <Button Content="📌" 
                                        Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Foreground="{Binding IsPinned, Converter={local:PinColorConverter}}" 
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        Margin="0,0,12,0" 
                                        Cursor="Hand"/>

                                <!-- Pegar button -->
                                <Button Content="Pegar" 
                                        Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Background="#10B981"
                                        Foreground="White"
                                        Padding="8,3,8,3"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Margin="0,0,12,0"
                                        Cursor="Hand"/>

                                <!-- Eliminar button -->
                                <Button Content="Eliminar" 
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" 
                                        Foreground="{StaticResource DangerBrush}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        FontSize="11"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detailed Preview Side Panel -->
            <Border Grid.Column="1" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="15">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Vista Previa de Detalle" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- If Text type details -->
                            <TextBlock Text="{Binding SelectedItem.PlainText}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       TextWrapping="Wrap" 
                                       FontSize="12"/>
                            
                            <!-- If Image details -->
                            <Image Source="{Binding SelectedItem.ImagePath}" 
                                   Margin="0,10,0,0" 
                                   Stretch="Uniform" 
                                   MaxHeight="300"
                                   HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
